# ── Base de datos (Railway la genera al añadir el plugin Postgres) ──
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# En Railway con Postgres del mismo proyecto normalmente no hace falta SSL:
DATABASE_SSL=false

# ── Culqi (https://culqi.com — llaves en Configuración → Desarrollo) ──
# Usa las llaves de PRUEBA (pk_test_/sk_test_) hasta completar la validación de Culqi.
CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# ── Resend (correos transaccionales, https://resend.com) ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Debe ser un remitente del dominio verificado en Resend:
EMAIL_FROM="El Profesor Carlos <cursos@tudominio.com>"

# ── App ──
APP_BASE_URL=https://tu-servicio.up.railway.app
ADMIN_PASSWORD=cambia-esta-clave-larga-y-unica
TIMEZONE=America/Lima

# Carpeta donde viven los PDFs (en Railway: montar un Volume en esta ruta)
PDF_DIR=/data/pdfs

# ── Datos que se muestran al comprador en el pago manual ──
# (deja vacío el que no uses y no se mostrará)
ZELLE_INFO="correo@ejemplo.com — Titular: Nombre Apellido"
PAGOMOVIL_INFO="Banco: 0102 · Tel: 0412-0000000 · CI: V-00000000"
BINANCE_INFO="Binance Pay ID: 000000000"
